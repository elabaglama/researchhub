rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal data — only the signed-in owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared scrape results — any signed-in user can read; only Admin SDK writes
    match /scrapeCache/{sourceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pending scrape jobs — Admin SDK only
    match /scrapeQueue/{sourceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Library share packs — owner creates; any signed-in user can import (read)
    match /sharedLibraries/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['code', 'ownerUid', 'sources']);
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
