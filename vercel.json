{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/researchhub",
      "destination": "/researchhub.html"
    },
    {
      "source": "/researchhub/",
      "destination": "/researchhub.html"
    },
    {
      "source": "/researchhub/:path*",
      "destination": "/:path*"
    }
  ]
}
